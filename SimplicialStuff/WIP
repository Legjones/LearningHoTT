variable (𝕜) (ι : Type*) [Semiring 𝕜] [LinearOrderedRing 𝕜] [Fintype ι]


def stdSimplex : Set (ι → 𝕜) :=
  { f | (∀ x, 0 ≤ f x) ∧ ∑ x, f x = 1 }

--This is expressing the topological horn i on the standard simplex that should be okay...
def stdSimplex_horn_i (i : ι) : Set (ι → 𝕜) :=
  {f | (∀ x, 0 ≤ f x) ∧ ∑ x, f x = 1 ∧ (f i > 0) ∧ (∃ y: ι, y ≠ i ∧ f y = 0)}
  ∪ {f | ∑ x, f x = 1 ∧ (∃ z, f z = 1)}


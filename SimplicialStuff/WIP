noncomputable def minOther (i:ι) (f : ι → 𝕜) : 𝕜 := by
  intros
  let hs : Finset ι := Finset.univ.erase i

--Below is not mine but might be useful for some tools/ideas I may need...
noncomputable def minOther (i : ι) (f : ι → ℝ) : ℝ :=
by
  classical
  let s : Finset ι := Finset.univ.erase i
  have hs : s.Nonempty := by
    rcases exists_ne i with ⟨j, hj⟩
    exact ⟨j, by simp [s, hj]⟩
  exact s.min' hs f

noncomputable def hornRetractionAmbient (i : ι) : (ι → ℝ) → (ι → ℝ) :=
  fun f j =>
    let m := minOther (ι := ι) i f
    if hj : j = i then
      f i + ((Finset.univ.erase i).card : ℝ) * m
    else
      f j - m

def horn_retrat_ofstdSimplex (j : ι) : stdSimplex → (stdSimplex_horn_i j)



